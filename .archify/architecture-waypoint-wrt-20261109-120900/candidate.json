    {
      "dot": "emerald",
      "title": "Micro-Footprint Daemon",
      "items": [
        "Single static binary written in safe Rust with zero external runtime dependencies",
        "Embedded Vite + React single-page app served directly from RAM",
        "Consumes < 2 MB RAM and 0% CPU on MIPS 24Kc (880 MHz) router hardware"
      ]
    },
    {
      "dot": "cyan",
      "title": "Granular Policy Routing",
      "items": [
        "1-tap per-device dispatching between Direct WAN and multi-region WireGuard relays",
        "Smart domain policies for streaming media services (Crunchyroll, Netflix, Disney+)",
        "Instant conntrack flow flushing on policy change with zero router downtime"
      ]
    },
    {
      "dot": "rose",
      "title": "Security & Cryptography",
      "items": [
        "Built-in EC P-256 CSR generator (~0.13s generation on embedded MIPS)",
        "Optional native stunnel TLS termination on configurable port (default :8443)",
        "Hardware-enforced strict killswitch prevents unencrypted IP and DNS leaks"
      ]
    }
