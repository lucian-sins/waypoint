#!/bin/sh
# ==============================================================================
# vpnctl ??? OpenWrt WireGuard & Policy-Based Routing (pbr) Companion CLI
# Target: TP-Link ER605 v2 & OpenWrt 21.02 / 22.03 / 23.05 / 24.10 / 25.x
# Zero external dependencies: pure POSIX /bin/sh (BusyBox ash compatible)
# ==============================================================================

set -e
trap 'rm -f /tmp/vpnctl_*.$$ 2>/dev/null || true' EXIT INT TERM

# ------------------------------------------------------------------------------
# 1. STATUS
# ------------------------------------------------------------------------------
cmd_status() {
  UPTIME_S=$(cut -d. -f1 /proc/uptime 2>/dev/null || echo 0)
  
  RELEASE="OpenWrt"
  if [ -f /etc/openwrt_release ]; then
    RELEASE=$(grep DISTRIB_RELEASE /etc/openwrt_release 2>/dev/null | cut -d\' -f2 || echo "OpenWrt")
  elif [ -f /etc/os-release ]; then
    RELEASE=$(grep VERSION_ID /etc/os-release 2>/dev/null | cut -d\" -f2 || echo "OpenWrt")
  fi

  WAN_IP=$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src") print $(i+1)}')
  [ -z "$WAN_IP" ] && WAN_IP="0.0.0.0"

  WAN_UP="false"
  if [ "$WAN_IP" != "0.0.0.0" ]; then
    WAN_UP="true"
  fi

  PBR_ENABLED="false"
  if [ -x /etc/init.d/pbr ] && /etc/init.d/pbr enabled >/dev/null 2>&1; then
    PBR_ENABLED="true"
  fi

  PBR_STRICT="true"
  STRICT_VAL=$(uci -q get pbr.config.strict_enforcement || echo "1")
  [ "$STRICT_VAL" = "0" ] && PBR_STRICT="false"

  PBR_POLICIES=$(uci -q show pbr | grep -c '=policy$' || echo 0)

  cat <<EOF
{
  "router": {
    "release": "$RELEASE",
    "uptime_s": $UPTIME_S,
    "wan_up": $WAN_UP,
    "wan_ip": "$WAN_IP"
  },
  "pbr": {
    "enabled": $PBR_ENABLED,
    "strict": $PBR_STRICT,
    "policies": $PBR_POLICIES
  }
}
EOF
}

# ------------------------------------------------------------------------------
# 2. DEVICES
# ------------------------------------------------------------------------------
cmd_devices() {
  # Build policy mapping table (ip -> tunnel)
  TMP_POLICIES="/tmp/vpnctl_policies.$$"
  rm -f "$TMP_POLICIES"
  uci -q show pbr | awk -F= '
    {
      split($1, p, ".");
      sec = p[2];
      prop = p[3];
      val = $2;
      gsub(/[\047"]/, "", val);
      if (prop == "src_addr") ip[sec] = val;
      if (prop == "interface") iface[sec] = val;
      if (prop == "enabled") en[sec] = val;
    }
    END {
      for (k in ip) {
        if (en[k] == "0") continue;
        clean_ip = ip[k];
        sub(/\/[0-9]+$/, "", clean_ip);
        if (clean_ip != "" && iface[k] != "") {
          print clean_ip, iface[k];
        }
      }
    }
  ' > "$TMP_POLICIES" 2>/dev/null || true

  # Build online IP map from ARP table
  TMP_ARP="/tmp/vpnctl_arp.$$"
  rm -f "$TMP_ARP"
  awk '{if(NR>1 && $4!="00:00:00:00:00:00") print $1, tolower($4)}' /proc/net/arp > "$TMP_ARP" 2>/dev/null || true

  # Extract static leases from uci dhcp
  TMP_STATIC="/tmp/vpnctl_static.$$"
  rm -f "$TMP_STATIC"
  uci -q show dhcp | awk -F'[.=]' '
    $0 ~ /@host\[[0-9]+\]\.ip=/ { ip[$2]=$3 }
    $0 ~ /@host\[[0-9]+\]\.mac=/ { mac[$2]=$3 }
    $0 ~ /@host\[[0-9]+\]\.name=/ { name[$2]=$3 }
    END {
      for (k in ip) {
        gsub(/[\047"]/, "", ip[k]);
        gsub(/[\047"]/, "", mac[k]);
        gsub(/[\047"]/, "", name[k]);
        if (ip[k] ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) {
          print ip[k], (mac[k] != "" ? tolower(mac[k]) : "00:00:00:00:00:00"), (name[k] != "" ? name[k] : "StaticHost")
        }
      }
    }
  ' > "$TMP_STATIC" 2>/dev/null || true

  # Extract bandwidth counters from nlbwmon (if installed) or conntrack fallback
  TMP_TRAFFIC="/tmp/vpnctl_traffic.$$"
  rm -f "$TMP_TRAFFIC"
  if command -v nlbw >/dev/null 2>&1 && [ -x /usr/bin/jsonfilter ]; then
    nlbw -c json -g ip 2>/dev/null | jsonfilter -e '@.data[*]' 2>/dev/null | tr -d '[],\x22' | awk '{print $1, $3, $5}' > "$TMP_TRAFFIC" 2>/dev/null || true
  elif [ -f /proc/net/nf_conntrack ]; then
    awk '
      /src=192\.168\./ {
        ip=""; rx=0; tx=0;
        for (i=1; i<=NF; i++) {
          if ($i ~ /^src=192\.168\./ && ip=="") { ip=substr($i, 5); }
          else if ($i ~ /^bytes=/ && tx==0) { tx=substr($i, 7)+0; }
          else if ($i ~ /^bytes=/ && tx>0) { rx=substr($i, 7)+0; }
        }
        if (ip != "") { dev_rx[ip]+=rx; dev_tx[ip]+=tx; }
      }
      END {
        for (ip in dev_rx) { print ip, dev_rx[ip], dev_tx[ip]; }
      }
    ' /proc/net/nf_conntrack > "$TMP_TRAFFIC" 2>/dev/null || true
  fi

  # Combine dynamic DHCP leases + static leases + active ARP entries
  awk -v policies_file="$TMP_POLICIES" -v arp_file="$TMP_ARP" -v static_file="$TMP_STATIC" -v traffic_file="$TMP_TRAFFIC" '
    BEGIN {
      while ((getline < policies_file) > 0) {
        policy[$1] = $2
      }
      while ((getline < arp_file) > 0) {
        online[$1] = 1
        if (!($1 in arp_mac)) arp_mac[$1] = $2
      }
      while ((getline < static_file) > 0) {
        ip = $1
        is_static[ip] = 1
        if (!(ip in dev_mac)) dev_mac[ip] = $2
        if (!(ip in dev_name)) dev_name[ip] = $3
      }
      while ((getline < traffic_file) > 0) {
        dev_rx[$1] = $2 + 0
        dev_tx[$1] = $3 + 0
      }

      first = 1
      printf "[\n"
    }

    # Process /tmp/dhcp.leases lines: timestamp mac ip name client_id
    {
      if (NF >= 3) {
        mac = tolower($2)
        ip = $3
        name = $4
        if (ip ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) {
          dev_mac[ip] = mac
          if (name != "*" && name != "") {
            dev_name[ip] = name
          }
        }
      }
    }

    END {
      # Merge any active ARP IPs not present in dhcp leases
      for (ip in online) {
        if (ip ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ && !(ip in dev_mac)) {
          dev_mac[ip] = (ip in arp_mac) ? arp_mac[ip] : "00:00:00:00:00:00"
        }
      }

      for (ip in dev_mac) {
        if (ip !~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) continue;
        mac = dev_mac[ip]
        name = (ip in dev_name) ? dev_name[ip] : ("Device-" ip)
        tun = (ip in policy) ? policy[ip] : "direct"
        is_online = (ip in online) ? "true" : "false"
        static_flag = (ip in is_static) ? "true" : "false"

        icon = "laptop"
        lower_name = tolower(name)
        if (lower_name ~ /(phone|iphone|android|pixel|galaxy)/) icon = "phone"
        else if (lower_name ~ /(tv|appletv|firetv|roku|bravia|chromecast)/) icon = "tv"
        else if (lower_name ~ /(pad|tablet)/) icon = "tablet"
        else if (lower_name ~ /(cam|plug|bulb|sensor|switch|homepod|echo|thermostat)/) icon = "iot"

        rx_val = (ip in dev_rx) ? dev_rx[ip] : 0
        tx_val = (ip in dev_tx) ? dev_tx[ip] : 0

        if (!first) printf ",\n"
        first = 0

        printf "  {\n"
        printf "    \"name\": \"%s\",\n", name
        printf "    \"mac\": \"%s\",\n", mac
        printf "    \"ip\": \"%s\",\n", ip
        printf "    \"static\": %s,\n", static_flag
        printf "    \"tunnel\": \"%s\",\n", tun
        printf "    \"policy\": \"%s\",\n", (tun == "direct" ? "none" : tun)
        printf "    \"online\": %s,\n", is_online
        printf "    \"icon\": \"%s\",\n", icon
        printf "    \"rx_bytes\": %d,\n", rx_val
        printf "    \"tx_bytes\": %d\n", tx_val
        printf "  }"
      }
      printf "\n]\n"
    }
  ' /tmp/dhcp.leases 2>/dev/null || echo "[]"

  rm -f "$TMP_POLICIES" "$TMP_ARP" "$TMP_STATIC" "$TMP_TRAFFIC"
}

# ------------------------------------------------------------------------------
# 3. TUNNELS
# ------------------------------------------------------------------------------
cmd_tunnels() {
  NOW=$(date +%s)
  
  # Collect device routing map: tunnel -> comma-separated IPs
  TMP_DEVMAP="/tmp/vpnctl_devmap.$$"
  rm -f "$TMP_DEVMAP"
  uci -q show pbr | awk -F= '
    {
      split($1, p, ".");
      sec = p[2];
      prop = p[3];
      val = $2;
      gsub(/[\047"]/, "", val);
      if (prop == "src_addr") ip[sec] = val;
      if (prop == "interface") iface[sec] = val;
      if (prop == "enabled") en[sec] = val;
    }
    END {
      for (k in ip) {
        if (en[k] == "0") continue;
        clean_ip = ip[k];
        sub(/\/[0-9]+$/, "", clean_ip);
        if (clean_ip != "" && iface[k] != "") {
          print iface[k], clean_ip;
        }
      }
    }
  ' > "$TMP_DEVMAP" 2>/dev/null || true

  # Collect all configured WireGuard interfaces & peers from UCI network
  TMP_CONFIG_WG="/tmp/vpnctl_cfg_wg.$$"
  rm -f "$TMP_CONFIG_WG"
  uci -q show network | awk -F= '
    {
      split($1, p, ".");
      sec = p[2];
      prop = p[3];
      val = $2;
      gsub(/[\047"]/, "", val);
      if (prop == "proto" && val == "wireguard") {
        is_wg[sec] = 1;
      }
      if (val ~ /^wireguard_/) {
        target = val;
        sub(/^wireguard_/, "", target);
        peer_to_iface[sec] = target;
      }
      if (prop == "description") {
        desc[sec] = val;
      }
      if (prop == "endpoint_host") {
        e_host[sec] = val;
      }
      if (prop == "endpoint_port") {
        e_port[sec] = val;
      }
    }
    END {
      for (iface in is_wg) {
        d = (iface in desc) ? desc[iface] : "";
        h = (iface in e_host) ? e_host[iface] : "";
        p = (iface in e_port) ? e_port[iface] : "";
        for (peer in peer_to_iface) {
          if (peer_to_iface[peer] == iface) {
            if (d == "" && (peer in desc)) d = desc[peer];
            if (h == "" && (peer in e_host)) h = e_host[peer];
            if (p == "" && (peer in e_port)) p = e_port[peer];
          }
        }
        peer_direct = iface "_peer";
        if (d == "" && (peer_direct in desc)) d = desc[peer_direct];
        if (h == "" && (peer_direct in e_host)) h = e_host[peer_direct];
        if (p == "" && (peer_direct in e_port)) p = e_port[peer_direct];

        port = (p != "") ? p : "51820";
        endpoint = (h != "") ? (h ":" port) : "";
        print iface "\t" d "\t" endpoint;
      }
    }
  ' > "$TMP_CONFIG_WG" 2>/dev/null || true

  # Collect live wireguard dump
  TMP_WGDUMP="/tmp/vpnctl_wg.$$"
  wg show all dump > "$TMP_WGDUMP" 2>/dev/null || true

  awk -v now="$NOW" -v devmap_file="$TMP_DEVMAP" -v cfg_file="$TMP_CONFIG_WG" '
    BEGIN {
      while ((getline < devmap_file) > 0) {
        if ($1 in devlist) devlist[$1] = devlist[$1] ", \"" $2 "\""
        else devlist[$1] = "\"" $2 "\""
      }
      num_ifaces = 0
      while ((getline < cfg_file) > 0) {
        split($0, parts, "\t");
        c_iface = parts[1];
        if (c_iface != "") {
          cfg_list[c_iface] = 1;
          cfg_desc[c_iface] = parts[2];
          cfg_endpoint[c_iface] = parts[3];
          if_order[++num_ifaces] = c_iface;
        }
      }
    }
    NF >= 9 { # Peer line in wg dump: iface pubkey psk endpoint allowed_ips handshake rx tx keepalive
      iface = $1
      wg_seen[iface] = 1
      wg_endpoint[iface] = $4
      wg_handshake[iface] = $6 + 0
      wg_rx[iface] = $7 + 0
      wg_tx[iface] = $8 + 0
      if (!(iface in cfg_list)) {
        if_order[++num_ifaces] = iface
      }
    }
    END {
      first = 1
      printf "[\n"
      for (i = 1; i <= num_ifaces; i++) {
        iface = if_order[i]
        is_up = (iface in wg_seen)

        if (is_up) {
          state = "up"
          handshake = wg_handshake[iface]
          age = (handshake > 0) ? (now - handshake) : 999999
          if (age < 0) age = 0
          rx = wg_rx[iface]
          tx = wg_tx[iface]
          endpoint = wg_endpoint[iface]
          if (endpoint == "(none)" || endpoint == "") {
            endpoint = (iface in cfg_endpoint) ? cfg_endpoint[iface] : ""
          }
        } else {
          state = "down"
          age = 999999
          rx = 0
          tx = 0
          endpoint = (iface in cfg_endpoint) ? cfg_endpoint[iface] : ""
        }

        # Derive label
        custom_desc = (iface in cfg_desc) ? cfg_desc[iface] : ""
        slug = tolower(iface)
        gsub(/^(wg|tun)/, "", slug)

        label = toupper(slug) " / Relay"
        if (slug == "us") label = "US / New York"
        else if (slug == "es") label = "ES / Madrid"
        else if (slug == "uk" || slug == "gb") label = "UK / London"
        else if (slug == "de") label = "DE / Frankfurt"
        else if (slug == "jp") label = "JP / Tokyo"
        else if (slug == "nl") label = "NL / Amsterdam"
        else if (slug == "cl") label = "CL / Santiago"
        else if (slug == "pt") label = "PT / Lisbon"
        else if (slug == "fr") label = "FR / Paris"
        else if (slug == "sg") label = "SG / Singapore"
        else if (slug == "ca") label = "CA / Toronto"
        else if (slug == "au") label = "AU / Sydney"
        else if (custom_desc ~ /\//) label = custom_desc
        else if (custom_desc != "" && custom_desc != toupper(slug)) label = custom_desc " / Relay"

        devices_json = (iface in devlist) ? devlist[iface] : ""

        if (!first) printf ",\n"
        first = 0

        printf "  {\n"
        printf "    \"id\": \"%s\",\n", iface
        printf "    \"label\": \"%s\",\n", label
        printf "    \"provider\": \"wireguard\",\n"
        printf "    \"state\": \"%s\",\n", state
        printf "    \"handshake_age_s\": %d,\n", age
        printf "    \"rx_bytes\": %d,\n", rx
        printf "    \"tx_bytes\": %d,\n", tx
        printf "    \"endpoint\": \"%s\",\n", endpoint
        printf "    \"devices\": [%s]\n", devices_json
        printf "  }"
      }
      printf "\n]\n"
    }
  ' "$TMP_WGDUMP"

  rm -f "$TMP_DEVMAP" "$TMP_WGDUMP" "$TMP_CONFIG_WG"
}

# ------------------------------------------------------------------------------
# 4. ASSIGN (Policy Routing)
# ------------------------------------------------------------------------------
cmd_assign() {
  IP="$1"
  TUNNEL="$2"

  if [ -z "$IP" ] || [ -z "$TUNNEL" ]; then
    echo "Usage: vpnctl assign <device-ip> <tunnel|direct>" >&2
    exit 1
  fi

  # Validate IPv4 format
  if ! echo "$IP" | grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}$'; then
    echo "Error: Invalid IP address format: $IP" >&2
    exit 1
  fi

  # Validate tunnel name format
  if ! echo "$TUNNEL" | grep -qE '^[a-zA-Z0-9_-]+$'; then
    echo "Error: Invalid tunnel name: $TUNNEL" >&2
    exit 1
  fi

  SAFE_IP=$(echo "$IP" | tr '.' '_')
  RULE_NAME="dev_${SAFE_IP}"

  # Remove any existing policy for this IP in pbr (both dev_IP, explicit names, and CIDR /32)
  uci -q delete pbr."$RULE_NAME" 2>/dev/null || true
  for s in $(uci -q show pbr | grep -E "src_addr='${IP}(/32)?'" | cut -d. -f2); do
    uci -q delete pbr."$s" 2>/dev/null || true
  done

  if [ "$TUNNEL" != "direct" ]; then
    uci -q set pbr."$RULE_NAME"=policy
    uci -q set pbr."$RULE_NAME".name="dev_$IP"
    uci -q set pbr."$RULE_NAME".src_addr="$IP"
    uci -q set pbr."$RULE_NAME".interface="$TUNNEL"
    uci -q set pbr."$RULE_NAME".enabled='1'
  fi

  # Ensure resolver_set is none so pbr reload does not produce unsupported resolver warnings
  if [ "$(uci -q get pbr.config.resolver_set)" != "none" ]; then
    uci -q set pbr.config.resolver_set='none'
  fi

  uci commit pbr

  # Reload policy routing (swallow any harmless non-zero warnings from pbr)
  if [ -x /etc/init.d/pbr ]; then
    /etc/init.d/pbr reload >/dev/null 2>&1 || true
  fi

  # Flush connection tracking so existing active flows immediately switch paths
  if which conntrack >/dev/null 2>&1; then
    conntrack -D -s "$IP" >/dev/null 2>&1 || conntrack -F >/dev/null 2>&1 || true
  fi

  echo "OK: $IP -> $TUNNEL"
}

# ------------------------------------------------------------------------------
# 5. TUNNEL POWER (UP / DOWN / CREATE / APPLY / DELETE)
# ------------------------------------------------------------------------------
cmd_tunnel_apply_conf() {
  ID="$1"
  LABEL="$2"

  if [ -z "$ID" ]; then
    echo "Error: Tunnel ID is required" >&2
    exit 1
  fi

  # Read entire .conf text from standard input into a temporary file
  TMP_CONF="/tmp/vpnctl_apply_${ID}.$$"
  cat > "$TMP_CONF"

  PRIV_KEY=$(grep -i '^[[:space:]]*PrivateKey' "$TMP_CONF" 2>/dev/null | head -n 1 | cut -d= -f2- | tr -d ' \r\t')
  ADDRESS=$(grep -i '^[[:space:]]*Address' "$TMP_CONF" 2>/dev/null | head -n 1 | cut -d= -f2- | tr -d ' \r\t')
  PUB_KEY=$(grep -i '^[[:space:]]*PublicKey' "$TMP_CONF" 2>/dev/null | head -n 1 | cut -d= -f2- | tr -d ' \r\t')
  ENDPOINT=$(grep -i '^[[:space:]]*Endpoint' "$TMP_CONF" 2>/dev/null | head -n 1 | cut -d= -f2- | tr -d ' \r\t')
  ALLOWED_IPS=$(grep -i '^[[:space:]]*AllowedIPs' "$TMP_CONF" 2>/dev/null | head -n 1 | cut -d= -f2- | tr -d ' \r\t')
  [ -z "$ALLOWED_IPS" ] && ALLOWED_IPS="0.0.0.0/0"

  ENDPOINT_HOST=$(echo "$ENDPOINT" | cut -d: -f1)
  ENDPOINT_PORT=$(echo "$ENDPOINT" | cut -d: -f2)
  [ -z "$ENDPOINT_PORT" ] && ENDPOINT_PORT="51820"

  # Clean any existing interface and peer with same id
  uci -q delete network."$ID" 2>/dev/null || true
  uci -q delete network."${ID}_peer" 2>/dev/null || true

  # 1. Interface
  uci -q set network."$ID"=interface
  uci -q set network."$ID".proto='wireguard'
  [ -n "$PRIV_KEY" ] && uci -q set network."$ID".private_key="$PRIV_KEY"
  [ -n "$ADDRESS" ] && uci -q set network."$ID".addresses="$ADDRESS"
  uci -q set network."$ID".mtu='1420'

  # 2. Peer
  uci -q set network."${ID}_peer"=wireguard_"$ID"
  [ -n "$LABEL" ] && uci -q set network."${ID}_peer".description="$LABEL"
  [ -n "$PUB_KEY" ] && uci -q set network."${ID}_peer".public_key="$PUB_KEY"
  [ -n "$ENDPOINT_HOST" ] && uci -q set network."${ID}_peer".endpoint_host="$ENDPOINT_HOST"
  [ -n "$ENDPOINT_PORT" ] && uci -q set network."${ID}_peer".endpoint_port="$ENDPOINT_PORT"
  uci -q set network."${ID}_peer".allowed_ips="$ALLOWED_IPS"
  uci -q set network."${ID}_peer".route_allowed_ips='0'
  uci -q set network."${ID}_peer".persistent_keepalive='25'

  uci commit network

  # 3. Add to firewall zone 'vpn' (or 'wan' fallback)
  VPN_ZONE=$(uci -q show firewall | grep -E "\.name='?vpn'?" | cut -d. -f2 | head -n 1)
  [ -z "$VPN_ZONE" ] && VPN_ZONE=$(uci -q show firewall | grep -E "\.name='?wan'?" | cut -d. -f2 | head -n 1)
  if [ -n "$VPN_ZONE" ]; then
    if ! uci -q get firewall."$VPN_ZONE".network | grep -qw "$ID"; then
      uci -q add_list firewall."$VPN_ZONE".network="$ID"
      uci commit firewall
      /etc/init.d/firewall reload >/dev/null 2>&1 || true
    fi
  fi

  rm -f "$TMP_CONF"

  # 4. Reload network and bring tunnel up
  /etc/init.d/network reload >/dev/null 2>&1 || true
  sleep 1
  ifup "$ID" >/dev/null 2>&1 || true

  cmd_tunnels
}

cmd_tunnel() {
  ACTION="$1"
  ARG2="$2"
  ARG3="$3"
  ARG4="$4"
  ARG5="$5"

  # Handle "tunnel apply <id> <label>" (reads .conf from stdin)
  if [ "$ACTION" = "apply" ]; then
    ID="$ARG2"
    LABEL="$ARG3"
    cmd_tunnel_apply_conf "$ID" "$LABEL"
    return 0
  fi

  # Handle "tunnel create <id> <label> <endpoint> [provider]"
  if [ "$ACTION" = "create" ]; then
    ID="$ARG2"
    LABEL="$ARG3"
    ENDPOINT="$ARG4"
    PROVIDER="${ARG5:-custom}"

    if [ -z "$ID" ]; then
      echo "Error: Tunnel ID is required" >&2
      exit 1
    fi

    uci -q set network."$ID"=interface
    uci -q set network."$ID".proto='wireguard'
    uci commit network
    if [ -x /etc/init.d/network ]; then
      /etc/init.d/network reload >/dev/null 2>&1 || true
    fi
    cmd_tunnels
    return 0
  fi

  # Handle "tunnel delete <id>"
  if [ "$ACTION" = "delete" ]; then
    ID="$ARG2"
    uci -q delete network."$ID" 2>/dev/null || true
    uci -q delete network."${ID}_peer" 2>/dev/null || true

    # Remove from firewall zone
    VPN_ZONE=$(uci -q show firewall | grep -E "\.name='?vpn'?" | cut -d. -f2 | head -n 1)
    if [ -n "$VPN_ZONE" ]; then
      uci -q del_list firewall."$VPN_ZONE".network="$ID" 2>/dev/null || true
      uci commit firewall
      /etc/init.d/firewall reload >/dev/null 2>&1 || true
    fi

    for s in $(uci -q show pbr | grep "interface='${ID}'" | cut -d. -f2); do
      uci -q delete pbr."$s" 2>/dev/null || true
    done
    uci commit pbr
    uci commit network
    if [ -x /etc/init.d/network ]; then
      /etc/init.d/network reload >/dev/null 2>&1 || true
    fi
    if [ -x /etc/init.d/pbr ]; then
      /etc/init.d/pbr reload >/dev/null 2>&1 || true
    fi
    echo "OK: deleted $ID"
    return 0
  fi

  # Handle "tunnel <id> <up|down>" OR "tunnel <up|down> <id>"
  if [ "$ACTION" = "up" ] || [ "$ACTION" = "down" ]; then
    TUNNEL_ID="$ARG2"
    ACT="$ACTION"
  else
    TUNNEL_ID="$ACTION"
    ACT="$ARG2"
  fi

  if [ "$ACT" = "up" ]; then
    ifup "$TUNNEL_ID" >/dev/null 2>&1 || true
  elif [ "$ACT" = "down" ]; then
    ifdown "$TUNNEL_ID" >/dev/null 2>&1 || true
  fi

  cmd_tunnels
}

# ------------------------------------------------------------------------------
# 6. PING
# ------------------------------------------------------------------------------
cmd_ping() {
  HOST="$1"
  [ -z "$HOST" ] && exit 1
  ping -c 2 -W 1 "$HOST" 2>&1
}

# ------------------------------------------------------------------------------
# 7. DISCOVER
# ------------------------------------------------------------------------------
cmd_discover() {
  # Flush neighbor cache and sweep active interfaces
  ip neigh flush all >/dev/null 2>&1 || true
  cmd_devices
}

# ------------------------------------------------------------------------------
# 8. APPS (Domain / Service Policy Routing)
# ------------------------------------------------------------------------------
cmd_apps() {
  uci -q show pbr | awk -F= '
    {
      split($1, p, ".");
      sec = p[2];
      prop = p[3];
      val = $2;
      gsub(/[\047"]/, "", val);

      if (prop == "name") name[sec] = val;
      else if (prop == "interface") iface[sec] = val;
      else if (prop == "src_addr") src[sec] = val;
      else if (prop == "enabled") en[sec] = val;
      else if (prop == "dest_addr") {
        if (sec in domains) domains[sec] = domains[sec] " " val;
        else domains[sec] = val;
      }
    }
    END {
      printf "[\n"
      first = 1
      for (s in domains) {
        if (domains[s] == "") continue;
        if (domains[s] !~ /[a-zA-Z]/) continue;

        sec_name = (s in name) ? name[s] : s;
        sec_iface = (s in iface) ? iface[s] : "direct";
        sec_src = (s in src) ? src[s] : "all";
        sub(/\/[0-9]+$/, "", sec_src);
        sec_en = (s in en && en[s] == "0") ? "false" : "true";

        n = split(domains[s], d_arr, /[ ,]+/);
        d_json = "";
        for (i = 1; i <= n; i++) {
          if (d_arr[i] != "") {
            d_json = (d_json == "") ? ("\"" d_arr[i] "\"") : (d_json ", \"" d_arr[i] "\"");
          }
        }

        s_lower = tolower(sec_name " " s);
        s_key = "custom";
        if (s_lower ~ /crunchyroll/) s_key = "crunchyroll";
        else if (s_lower ~ /youtube/) s_key = "youtube";
        else if (s_lower ~ /netflix/) s_key = "netflix";
        else if (s_lower ~ /disney/) s_key = "disney";
        else if (s_lower ~ /max|hbo/) s_key = "max";
        else if (s_lower ~ /bbc/) s_key = "bbc";
        else if (s_lower ~ /prime/) s_key = "prime";
        else if (s_lower ~ /twitch/) s_key = "twitch";
        else if (s_lower ~ /steam/) s_key = "steam";

        if (!first) printf ",\n";
        first = 0;

        printf "  {\n";
        printf "    \"id\": \"%s\",\n", s;
        printf "    \"name\": \"%s\",\n", sec_name;
        printf "    \"serviceKey\": \"%s\",\n", s_key;
        printf "    \"tunnel\": \"%s\",\n", sec_iface;
        printf "    \"targetDevice\": \"%s\",\n", sec_src;
        printf "    \"domains\": [%s],\n", d_json;
        printf "    \"enabled\": %s\n", sec_en;
        printf "  }";
      }
      printf "\n]\n"
    }
  '
}

cmd_app_set() {
  ID="$1"
  TUNNEL="$2"
  TARGET_DEV="$3"
  NAME="$4"
  shift 4
  DOMAINS="$*"

  if [ -z "$ID" ] || [ -z "$TUNNEL" ]; then
    echo "Usage: vpnctl app_set <id> <tunnel> <target_dev|all> <name> <domain1> [domain2...]" >&2
    exit 1
  fi

  ID=$(echo "$ID" | sed 's/[^a-zA-Z0-9_]/_/g' | tr 'A-Z' 'a-z')
  [ "${ID#app_}" = "$ID" ] && ID="app_$ID"

  # Validate target device
  if [ "$TARGET_DEV" != "all" ] && [ -n "$TARGET_DEV" ]; then
    if ! echo "$TARGET_DEV" | grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}(/[0-9]{1,2})?$'; then
      TARGET_DEV="all"
    fi
  fi

  uci -q set pbr."$ID"=policy
  uci -q set pbr."$ID".name="${NAME:-$ID}"
  uci -q set pbr."$ID".interface="$TUNNEL"

  if [ "$TARGET_DEV" != "all" ] && [ -n "$TARGET_DEV" ]; then
    uci -q set pbr."$ID".src_addr="$TARGET_DEV"
  else
    uci -q delete pbr."$ID".src_addr 2>/dev/null || true
  fi

  uci -q delete pbr."$ID".dest_addr 2>/dev/null || true
  for d in $DOMAINS; do
    d_clean=$(echo "$d" | tr -d ' \r\t,' | tr 'A-Z' 'a-z' | sed 's/[^a-z0-9.-]//g')
    [ -n "$d_clean" ] && uci -q add_list pbr."$ID".dest_addr="$d_clean"
  done

  uci -q set pbr."$ID".enabled='1'
  uci commit pbr

  /etc/init.d/pbr reload >/dev/null 2>&1 || true
  echo "OK: $ID"
}

cmd_app_delete() {
  ID="$1"
  if [ -z "$ID" ]; then
    echo "Usage: vpnctl app_delete <id>" >&2
    exit 1
  fi
  uci -q delete pbr."$ID" 2>/dev/null || true
  uci commit pbr
  /etc/init.d/pbr reload >/dev/null 2>&1 || true
  echo "OK: deleted $ID"
}

cmd_app_toggle() {
  ID="$1"
  EN="${2:-1}"
  if [ -z "$ID" ]; then
    echo "Usage: vpnctl app_toggle <id> <0|1>" >&2
    exit 1
  fi
  uci -q set pbr."$ID".enabled="$EN"
  uci commit pbr
  /etc/init.d/pbr reload >/dev/null 2>&1 || true
  echo "OK: $ID enabled=$EN"
}

# ------------------------------------------------------------------------------
# 8. STRICT PBR (KILL SWITCH) & UNIFIED TELEMETRY
# ------------------------------------------------------------------------------
cmd_strict() {
  ARG="${1:-}"
  if [ "$ARG" = "1" ] || [ "$ARG" = "on" ] || [ "$ARG" = "true" ]; then
    VAL="1"
  elif [ "$ARG" = "0" ] || [ "$ARG" = "off" ] || [ "$ARG" = "false" ]; then
    VAL="0"
  else
    CUR=$(uci -q get pbr.config.strict_enforcement || echo "1")
    [ "$CUR" = "1" ] && VAL="0" || VAL="1"
  fi
  uci -q set pbr.config.strict_enforcement="$VAL"
  uci commit pbr
  /etc/init.d/pbr reload >/dev/null 2>&1 || true
  echo "OK: strict=$VAL"
}

cmd_telemetry() {
  printf '{"status":'
  cmd_status
  printf ',"devices":'
  cmd_devices
  printf ',"tunnels":'
  cmd_tunnels
  printf ',"apps":'
  cmd_apps
  printf '}\n'
}

# ------------------------------------------------------------------------------
# 14. SSL & WEB SERVER SECURITY MANAGEMENT
# ------------------------------------------------------------------------------
cmd_ssl() {
  SUBCMD="${1:-status}"
  shift || true

  SSL_DIR="/etc/waypoint/ssl"
  mkdir -p "$SSL_DIR"

  case "$SUBCMD" in
    status)
      HAS_OPENSSL="false"
      command -v openssl >/dev/null 2>&1 && HAS_OPENSSL="true"

      HAS_STUNNEL="false"
      command -v stunnel >/dev/null 2>&1 && HAS_STUNNEL="true"

      STUNNEL_ACTIVE="false"
      pgrep stunnel >/dev/null 2>&1 && STUNNEL_ACTIVE="true"

      HAS_CERT="false"
      HAS_KEY="false"
      HAS_CSR="false"
      [ -f "$SSL_DIR/waypoint.crt" ] && HAS_CERT="true"
      [ -f "$SSL_DIR/waypoint.key" ] && HAS_KEY="true"
      [ -f "$SSL_DIR/waypoint.csr" ] && HAS_CSR="true"

      SUBJECT=""
      ISSUER=""
      VALID_TO=""
      SAN_LIST="[]"

      if [ "$HAS_CERT" = "true" ] && [ "$HAS_OPENSSL" = "true" ]; then
        SUBJECT=$(openssl x509 -in "$SSL_DIR/waypoint.crt" -noout -subject 2>/dev/null | sed 's/subject=//' | tr -d '"\r\n' || echo "")
        ISSUER=$(openssl x509 -in "$SSL_DIR/waypoint.crt" -noout -issuer 2>/dev/null | sed 's/issuer=//' | tr -d '"\r\n' || echo "")
        VALID_TO=$(openssl x509 -in "$SSL_DIR/waypoint.crt" -noout -enddate 2>/dev/null | sed 's/notAfter=//' | tr -d '"\r\n' || echo "")
        
        SANS_RAW=$(openssl x509 -in "$SSL_DIR/waypoint.crt" -noout -ext subjectAltName 2>/dev/null | grep -v 'X509v3' | tr -d '\r\n' | sed 's/^[ \t]*//' || echo "")
        if [ -n "$SANS_RAW" ]; then
          SAN_JSON=""
          for s in $(echo "$SANS_RAW" | tr ',' ' '); do
            clean_s=$(echo "$s" | sed 's/^[A-Za-z0-9 ]*://')
            if [ -z "$SAN_JSON" ]; then
              SAN_JSON="\"$clean_s\""
            else
              SAN_JSON="$SAN_JSON, \"$clean_s\""
            fi
          done
          SAN_LIST="[$SAN_JSON]"
        fi
      fi

      CSR_CONTENT=""
      if [ "$HAS_CSR" = "true" ]; then
        CSR_CONTENT=$(awk '{printf "%s\\n", $0}' "$SSL_DIR/waypoint.csr" 2>/dev/null || echo "")
      fi

      cat <<EOF
{
  "has_openssl": $HAS_OPENSSL,
  "has_stunnel": $HAS_STUNNEL,
  "stunnel_active": $STUNNEL_ACTIVE,
  "has_cert": $HAS_CERT,
  "has_key": $HAS_KEY,
  "has_csr": $HAS_CSR,
  "subject": "$SUBJECT",
  "issuer": "$ISSUER",
  "valid_to": "$VALID_TO",
  "sans": $SAN_LIST,
  "csr": "$CSR_CONTENT"
}
EOF
      ;;

    csr)
      CN="${1:-router.lan}"
      SANS_ARG="${2:-$CN}"
      ORG="${3:-WayPoint}"
      C="${4:-US}"

      if ! command -v openssl >/dev/null 2>&1; then
        echo '{"error":"openssl-util is required to generate CSR. Please install it via apk or opkg."}'
        exit 1
      fi

      SAN_DIRECTIVE=""
      for item in $(echo "$SANS_ARG" | tr ',' ' '); do
        clean_item=$(echo "$item" | tr -d ' ')
        [ -z "$clean_item" ] && continue
        
        if echo "$clean_item" | grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}$'; then
          TAG="IP"
        else
          TAG="DNS"
        fi
        if [ -z "$SAN_DIRECTIVE" ]; then
          SAN_DIRECTIVE="${TAG}:${clean_item}"
        else
          SAN_DIRECTIVE="${SAN_DIRECTIVE},${TAG}:${clean_item}"
        fi
      done

      [ -z "$SAN_DIRECTIVE" ] && SAN_DIRECTIVE="DNS:${CN}"

      openssl req -new -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes \
        -keyout "$SSL_DIR/waypoint.key" \
        -out "$SSL_DIR/waypoint.csr" \
        -subj "/CN=${CN}/O=${ORG}/C=${C}" \
        -addext "subjectAltName=${SAN_DIRECTIVE}" >/dev/null 2>&1

      chmod 600 "$SSL_DIR/waypoint.key"
      chmod 644 "$SSL_DIR/waypoint.csr"

      CSR_OUT=$(awk '{printf "%s\\n", $0}' "$SSL_DIR/waypoint.csr")
      echo "{\"success\":true,\"common_name\":\"$CN\",\"sans\":\"$SAN_DIRECTIVE\",\"csr\":\"$CSR_OUT\"}"
      ;;

    cert)
      TARGET_PORT="${1:-8443}"
      cat > "$SSL_DIR/waypoint.crt"

      if ! command -v openssl >/dev/null 2>&1; then
        echo '{"error":"openssl-util is required to validate certificate."}'
        exit 1
      fi

      if ! openssl x509 -in "$SSL_DIR/waypoint.crt" -noout 2>/dev/null; then
        rm -f "$SSL_DIR/waypoint.crt"
        echo '{"error":"Invalid X.509 PEM certificate content provided."}'
        exit 1
      fi

      if [ ! -f "$SSL_DIR/waypoint.key" ]; then
        echo '{"error":"Private key not found at /etc/waypoint/ssl/waypoint.key. Please generate a CSR first."}'
        exit 1
      fi

      cat <<EOF > "$SSL_DIR/stunnel.conf"
pid = /var/run/waypoint-stunnel.pid
foreground = no
output = /var/log/stunnel.log

[waypoint-https]
accept = 0.0.0.0:${TARGET_PORT}
connect = 127.0.0.1:8440
cert = $SSL_DIR/waypoint.crt
key = $SSL_DIR/waypoint.key
EOF

      SETTINGS_FILE="/etc/waypoint/settings.json"
      if [ -f "$SETTINGS_FILE" ]; then
        sed -i 's/"ssl_enabled":[ ]*[a-z]*/"ssl_enabled": true/' "$SETTINGS_FILE"
      fi

      (sleep 1 && /etc/init.d/waypoint restart) >/dev/null 2>&1 &

      SUBJECT=$(openssl x509 -in "$SSL_DIR/waypoint.crt" -noout -subject 2>/dev/null | sed 's/subject=//' | tr -d '"\r\n' || echo "")
      VALID_TO=$(openssl x509 -in "$SSL_DIR/waypoint.crt" -noout -enddate 2>/dev/null | sed 's/notAfter=//' | tr -d '"\r\n' || echo "")

      echo "{\"success\":true,\"ssl_enabled\":true,\"subject\":\"$SUBJECT\",\"valid_to\":\"$VALID_TO\"}"
      ;;

    disable)
      SETTINGS_FILE="/etc/waypoint/settings.json"
      if [ -f "$SETTINGS_FILE" ]; then
        sed -i 's/"ssl_enabled":[ ]*[a-z]*/"ssl_enabled": false/' "$SETTINGS_FILE"
      fi
      (sleep 1 && /etc/init.d/waypoint restart) >/dev/null 2>&1 &
      echo '{"success":true,"ssl_enabled":false}'
      ;;

    enable)
      TARGET_PORT="${1:-8443}"
      if [ ! -f "$SSL_DIR/waypoint.crt" ] || [ ! -f "$SSL_DIR/waypoint.key" ]; then
        echo '{"error":"Cannot enable SSL: waypoint.crt or waypoint.key missing in /etc/waypoint/ssl."}'
        exit 1
      fi

      cat <<EOF > "$SSL_DIR/stunnel.conf"
pid = /var/run/waypoint-stunnel.pid
foreground = no
output = /var/log/stunnel.log

[waypoint-https]
accept = 0.0.0.0:${TARGET_PORT}
connect = 127.0.0.1:8440
cert = $SSL_DIR/waypoint.crt
key = $SSL_DIR/waypoint.key
EOF

      SETTINGS_FILE="/etc/waypoint/settings.json"
      if [ -f "$SETTINGS_FILE" ]; then
        sed -i 's/"ssl_enabled":[ ]*[a-z]*/"ssl_enabled": true/' "$SETTINGS_FILE"
      fi

      (sleep 1 && /etc/init.d/waypoint restart) >/dev/null 2>&1 &
      echo "{\"success\":true,\"ssl_enabled\":true,\"port\":$TARGET_PORT}"
      ;;

    port)
      NEW_PORT="${1:-8443}"
      if [ -z "$NEW_PORT" ] || [ "$NEW_PORT" -lt 1 ] 2>/dev/null || [ "$NEW_PORT" -gt 65535 ] 2>/dev/null; then
        echo '{"error":"Port must be between 1 and 65535."}'
        exit 1
      fi

      SETTINGS_FILE="/etc/waypoint/settings.json"
      if [ -f "$SETTINGS_FILE" ]; then
        if grep -q '"port":' "$SETTINGS_FILE"; then
          sed -i "s/\"port\":[ ]*[0-9]*/\"port\": $NEW_PORT/" "$SETTINGS_FILE"
        fi
      fi

      if [ -f "$SSL_DIR/stunnel.conf" ]; then
        sed -i "s/accept = 0.0.0.0:[0-9]*/accept = 0.0.0.0:$NEW_PORT/" "$SSL_DIR/stunnel.conf"
      fi

      (sleep 1 && /etc/init.d/waypoint restart) >/dev/null 2>&1 &
      echo "{\"success\":true,\"port\":$NEW_PORT}"
      ;;
  esac
}

# ------------------------------------------------------------------------------
# CLI ROUTER DISPATCH
# ------------------------------------------------------------------------------
case "$1" in
  status)
    cmd_status
    ;;
  ssl)
    shift
    cmd_ssl "$@"
    ;;
  telemetry)
    cmd_telemetry
    ;;
  strict)
    shift
    cmd_strict "$@"
    ;;
  devices)
    cmd_devices
    ;;
  tunnels)
    cmd_tunnels
    ;;
  assign)
    shift
    cmd_assign "$@"
    ;;
  tunnel)
    shift
    cmd_tunnel "$@"
    ;;
  apps)
    cmd_apps
    ;;
  app_set)
    shift
    cmd_app_set "$@"
    ;;
  app_delete)
    shift
    cmd_app_delete "$@"
    ;;
  app_toggle)
    shift
    cmd_app_toggle "$@"
    ;;
  ping)
    shift
    cmd_ping "$@"
    ;;
  discover)
    cmd_discover
    ;;
  *)
    echo "vpnctl: OpenWrt WireGuard & Policy-Based Routing CLI"
    echo "Commands: status, telemetry, strict, devices, tunnels, assign, tunnel, apps, app_set, app_delete, app_toggle, ping, discover"
    exit 1
    ;;
esac

