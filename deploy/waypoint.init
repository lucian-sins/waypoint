#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

PROG=/usr/bin/waypoint

start_service() {
    PORT=8443
    SSL_ENABLED="false"
    SETTINGS_FILE="/etc/waypoint/settings.json"
    if [ -f "$SETTINGS_FILE" ]; then
        READ_PORT=$(grep -o '"port":[ ]*[0-9]*' "$SETTINGS_FILE" | head -n 1 | awk -F: '{print $2}' | tr -d ' ')
        [ -n "$READ_PORT" ] && PORT="$READ_PORT"
        READ_SSL=$(grep -o '"ssl_enabled":[ ]*[a-z]*' "$SETTINGS_FILE" | head -n 1 | awk -F: '{print $2}' | tr -d ' ')
        [ -n "$READ_SSL" ] && SSL_ENABLED="$READ_SSL"
    fi

    SSL_DIR="/etc/waypoint/ssl"
    if [ "$SSL_ENABLED" = "true" ] && [ -f "$SSL_DIR/stunnel.conf" ] && [ -f "$SSL_DIR/waypoint.crt" ] && [ -f "$SSL_DIR/waypoint.key" ]; then
        killall stunnel 2>/dev/null || true
        stunnel "$SSL_DIR/stunnel.conf" 2>/dev/null || true
        DAEMON_PORT=8440
    else
        killall stunnel 2>/dev/null || true
        DAEMON_PORT="$PORT"
    fi

    procd_open_instance
    procd_set_param command "$PROG" --port "$DAEMON_PORT"
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    killall stunnel 2>/dev/null || true
}
